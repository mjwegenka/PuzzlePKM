{
  "name": "puzzlepkm",
  "description": "A local-first knowledge management app with local folder sync",
  "author": "PuzzlePKM",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "cli": "node ./cli.mjs",
    "mcp": "node ./cli/mcp/server.mjs",
    "mcp:build-bundle": "node ./scripts/build_mcpb.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:all": "npm run build",
    "changeset": "changeset",
    "test:sync-parser": "node --no-warnings --test ./scripts/sync_parser.test.mjs",
    "test:smoke": "node --no-warnings --test ./scripts/cli_smoke.test.mjs",
    "test:mcp": "node --no-warnings --test ./scripts/mcp_server.test.mjs",
    "test:linked-sources": "node --no-warnings --test ./scripts/linked_sources.test.mjs",
    "test:documents": "node --no-warnings --test ./scripts/document_index.test.mjs",
    "test:habits": "node --no-warnings --test ./scripts/habits.test.mjs",
    "test:tasks": "node --no-warnings --test ./scripts/tasks.test.mjs",
    "test:markdown-tasks": "node --no-warnings --test ./scripts/markdown_task_lists.test.mjs",
    "benchmark:sqlite": "node ./scripts/sqlite_benchmark.mjs",
    "issues:queue": "node ./scripts/issue_sequence_runner.mjs",
    "issues:queue:apply": "node ./scripts/issue_sequence_runner.mjs --apply",
    "git:setup-local-branches": "bash ./scripts/setup_local_branch_workflow.sh",
    "tauri:dev": "tauri dev",
    "macos:preflight": "node ./scripts/macos_release_preflight.mjs",
    "macos:preflight:strict": "node ./scripts/macos_release_preflight.mjs --strict",
    "macos:verify": "node ./scripts/verify_macos_bundle.mjs",
    "tauri:build": "node ./scripts/run_tauri_build.mjs",
    "tauri:build:publish": "node ./scripts/run_tauri_build_publish.mjs",
    "version:sync": "node ./scripts/sync_versions.mjs",
    "version:check": "node ./scripts/sync_versions.mjs --check",
    "version:prepare": "changeset version && npm run version:sync",
    "lint": "TYPESCRIPT_ESLINT_IGNORE_UNSUPPORTED_VERSION=true eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tiptap/extension-blockquote": "^3.23.1",
    "@tiptap/extension-bold": "^3.23.1",
    "@tiptap/extension-bubble-menu": "^3.23.1",
    "@tiptap/extension-bullet-list": "^3.23.1",
    "@tiptap/extension-character-count": "^3.23.1",
    "@tiptap/extension-code-block": "^3.23.1",
    "@tiptap/extension-hard-break": "^3.23.1",
    "@tiptap/extension-heading": "^3.23.1",
    "@tiptap/extension-highlight": "^3.23.1",
    "@tiptap/extension-horizontal-rule": "^3.23.1",
    "@tiptap/extension-italic": "^3.23.1",
    "@tiptap/extension-link": "^3.23.1",
    "@tiptap/extension-mention": "^3.23.1",
    "@tiptap/extension-ordered-list": "^3.23.1",
    "@tiptap/extension-placeholder": "^3.23.1",
    "@tiptap/extension-strike": "^3.23.1",
    "@tiptap/extension-task-item": "^3.23.1",
    "@tiptap/extension-task-list": "^3.23.1",
    "@tiptap/extension-underline": "^3.23.1",
    "@tiptap/react": "^3.23.1",
    "@tiptap/starter-kit": "^3.23.1",
    "aslan-ui": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.3",
    "react": "^18.2.0",
    "react-day-picker": "^10.0.0",
    "react-dom": "^18.2.0",
    "react-force-graph": "^1.48.2",
    "react-router-dom": "^7.15.0",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.0.0",
    "@tippyjs/react": "^4.2.6",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "tailwindcss": "^4.3.0",
    "tippy.js": "^6.3.7",
    "typescript": "^5.2.2",
    "vite": "^6.4.2"
  },
  "bin": {
    "puzzlepkm": "./cli.mjs"
  }
}
