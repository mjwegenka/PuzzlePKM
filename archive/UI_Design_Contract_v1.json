{
  "$schemaVersion": "1.0.0",
  "meta": {
    "name": "Jesuit Tampa UI Contract",
    "sourceFiles": [
      "src/app/globals.css",
      "src/app/layout.tsx",
      "src/components/BottomNav.tsx",
      "src/components/AppBrand.tsx",
      "src/components/SummaryWeekNav.tsx",
      "src/components/CalendarManager.tsx",
      "components.json",
      "tailwind.config.ts"
    ],
    "notes": [
      "Contract captures visual/interaction equivalence, not domain data schema.",
      "Token names preserve source semantics for easier mapping."
    ]
  },
  "tokens": {
    "color": {
      "background": "#0b1828",
      "foreground": "#e4f0fb",
      "surface": "#0e2038",
      "surfaceLow": "#0b1828",
      "surfaceHigh": "#152e50",
      "outline": "#1c3558",
      "primary": "#1a8ab5",
      "primaryInk": "#ffffff",
      "mutedForeground": "#7dbad6",
      "destructive": "rgba(185,28,28,0.85)",
      "overlayScrim": "rgba(0,0,0,0.5)",
      "todayBg": "rgba(26,138,181,0.12)",
      "todayBorder": "rgba(26,138,181,0.45)",
      "selection": "rgba(26,138,181,0.3)"
    },
    "status": {
      "success": {
        "bg": "rgba(6,120,70,0.18)",
        "border": "rgba(16,185,129,0.4)",
        "text": "#34d399"
      },
      "warning": {
        "bg": "rgba(180,100,10,0.18)",
        "border": "rgba(220,140,20,0.4)",
        "text": "#fbbf24"
      },
      "error": {
        "bg": "rgba(185,28,28,0.18)",
        "border": "rgba(220,60,60,0.4)",
        "text": "#f87171"
      }
    },
    "typography": {
      "fontFamilySans": "Geist, Inter, system-ui, -apple-system, Segoe UI, sans-serif",
      "fontFamilyMono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace",
      "sizes": {
        "2xs": "10px",
        "xs": "12px",
        "sm": "14px",
        "base": "16px",
        "lg": "18px"
      },
      "weights": {
        "medium": 500,
        "semibold": 600
      },
      "tracking": {
        "wideUppercase": "0.04em"
      }
    },
    "radius": {
      "control": "0.9rem",
      "lg": "0.75rem",
      "xl": "1rem",
      "2xl": "1rem",
      "pill": "9999px"
    },
    "shadow": {
      "base": "0 4px 20px rgba(0,0,0,0.45), 0 1px 6px rgba(0,0,0,0.3)",
      "elevated": "0 4px 20px rgba(0,0,0,0.45), 0 1px 6px rgba(0,0,0,0.3)"
    },
    "motion": {
      "controlTransition": "all 160ms ease",
      "fabHoverScale": 1.1
    },
    "focus": {
      "outlineWidth": "2px",
      "outlineColor": "#1a8ab5",
      "outlineOffset": "2px"
    },
    "breakpoints": {
      "md": 768
    },
    "layout": {
      "maxContentWidth": "1180px",
      "pagePaddingMobile": "1.25rem 1rem 1.5rem",
      "pagePaddingDesktop": "2rem",
      "desktopSidebarWidth": "16rem",
      "mobileBottomNavMaxWidth": "32rem"
    }
  },
  "globalRules": {
    "body": {
      "background": "{color.background}",
      "color": "{color.foreground}",
      "fontFamily": "{typography.fontFamilySans}",
      "antialias": true
    },
    "interactiveElements": {
      "defaultRadius": "{radius.control}",
      "focusVisible": {
        "outline": "{focus.outlineWidth} solid {focus.outlineColor}",
        "outlineOffset": "{focus.outlineOffset}"
      }
    },
    "inputs": {
      "bg": "{color.surfaceHigh}",
      "text": "{color.foreground}",
      "border": "{color.outline}",
      "placeholder": "{color.mutedForeground}",
      "mobileMinFontSizePx": 16
    },
    "selection": {
      "background": "{color.selection}"
    }
  },
  "primitives": {
    "pageContainer": {
      "selectorEquivalent": ".app-page",
      "maxWidth": "{layout.maxContentWidth}",
      "marginX": "auto",
      "width": "100%",
      "padding": {
        "<md": "{layout.pagePaddingMobile}",
        ">=md": "{layout.pagePaddingDesktop}"
      }
    },
    "sectionCard": {
      "selectorEquivalent": ".app-section-card",
      "border": "1px solid {color.outline}",
      "radius": "{radius.xl}",
      "background": "{color.surface}",
      "shadow": "{shadow.base}",
      "padding": "1rem"
    },
    "toolbar": {
      "selectorEquivalent": ".app-toolbar",
      "display": "flex",
      "wrap": "wrap",
      "alignItems": "center",
      "justifyContent": "space-between",
      "gap": "0.75rem",
      "marginBottom": "1rem"
    },
    "toolbarTitle": {
      "selectorEquivalent": ".app-toolbar-title",
      "fontSize": "{typography.sizes.lg}",
      "fontWeight": "{typography.weights.semibold}",
      "color": "{color.foreground}"
    },
    "controlRow": {
      "selectorEquivalent": ".app-controls",
      "display": "flex",
      "wrap": "wrap",
      "alignItems": "center",
      "gap": "0.5rem"
    },
    "control": {
      "selectorEquivalent": ".app-control",
      "border": "1px solid {color.outline}",
      "radius": "{radius.control}",
      "padding": "0.5rem 0.75rem",
      "fontSize": "{typography.sizes.sm}",
      "textColor": "{color.foreground}",
      "background": "{color.surface}",
      "hoverBackground": "{color.surfaceHigh}"
    },
    "banner": {
      "success": {
        "radius": "{radius.xl}",
        "padding": "0.75rem 1rem",
        "textSize": "{typography.sizes.sm}",
        "border": "1px solid {status.success.border}",
        "background": "{status.success.bg}",
        "text": "{status.success.text}"
      },
      "error": {
        "radius": "{radius.xl}",
        "padding": "0.75rem 1rem",
        "textSize": "{typography.sizes.sm}",
        "border": "1px solid {status.error.border}",
        "background": "{status.error.bg}",
        "text": "{status.error.text}"
      }
    },
    "modal": {
      "overlay": {
        "position": "fixed",
        "inset": 0,
        "zIndex": 50,
        "display": "flex",
        "alignItems": "center",
        "justifyContent": "center",
        "padding": "1rem",
        "background": "{color.overlayScrim}"
      },
      "panel": {
        "radius": "{radius.xl}",
        "background": "{color.surface}",
        "shadow": "{shadow.elevated}",
        "padding": "1.5rem",
        "width": "100%",
        "maxHeight": "90vh",
        "overflowY": "auto"
      },
      "sizes": {
        "md": "28rem",
        "2xl": "42rem"
      },
      "header": {
        "layout": "row between",
        "marginBottom": "1rem",
        "titleSize": "{typography.sizes.lg}",
        "titleWeight": "{typography.weights.semibold}"
      }
    }
  },
  "shell": {
    "mobileBottomNav": {
      "visible": "<md",
      "position": "fixed bottom full-width",
      "zIndex": 50,
      "borderTop": "1px solid {color.outline}",
      "background": "{color.surface} @95%",
      "backdropBlur": true,
      "container": {
        "maxWidth": "{layout.mobileBottomNavMaxWidth}",
        "marginX": "auto",
        "layout": "row space-around"
      },
      "item": {
        "layout": "column center",
        "gap": "0.125rem",
        "padding": "0.75rem 1rem",
        "fontSize": "{typography.sizes.xs}",
        "fontWeight": "{typography.weights.medium}",
        "inactiveText": "{color.mutedForeground}",
        "hoverText": "{color.foreground}",
        "activeText": "{color.primary}",
        "iconSize": "24px",
        "activeIconStrokeWidth": 2.5
      },
      "items": ["Home", "Calendar", "Dinner", "Shop", "Rooms"]
    },
    "desktopSidebar": {
      "visible": ">=md",
      "position": "fixed left full-height",
      "zIndex": 40,
      "width": "{layout.desktopSidebarWidth}",
      "borderRight": "1px solid {color.outline}",
      "background": "{color.surface} @95%",
      "backdropBlur": true,
      "header": {
        "padding": "1.5rem 1.25rem",
        "label": {
          "text": "Navigation",
          "size": "{typography.sizes.xs}",
          "uppercase": true,
          "tracking": "{typography.tracking.wideUppercase}",
          "color": "{color.mutedForeground}"
        }
      },
      "link": {
        "padding": "0.5rem 0.75rem",
        "radius": "{radius.xl}",
        "fontSize": "{typography.sizes.sm}",
        "fontWeight": "{typography.weights.medium}",
        "layout": "row gap-3",
        "iconSize": "20px",
        "active": {
          "background": "{color.primary}",
          "text": "{color.primaryInk}",
          "shadow": "{shadow.base}"
        },
        "inactive": {
          "text": "{color.mutedForeground}",
          "hoverBackground": "{color.surfaceHigh}",
          "hoverText": "{color.foreground}"
        }
      },
      "items": ["Home", "Calendar", "Dinner", "Shop", "Rooms", "Admin"]
    },
    "brandLogoCard": {
      "border": "1px solid {color.outline}",
      "background": "{color.surface}",
      "radius": "{radius.lg}",
      "shadow": "{shadow.base}",
      "compactWidth": "7rem",
      "defaultMaxWidth": "9rem",
      "defaultMaxWidthMd": "11rem"
    }
  },
  "calendar": {
    "container": {
      "stackGap": "1.25rem",
      "bottomPadding": "1.5rem"
    },
    "toolbar": {
      "titleSource": {
        "month": "MMMM yyyy",
        "range": "M/d - M/d",
        "specialFilter": "Superior's Travel (All dates)"
      },
      "controls": [
        "datePicker",
        "eventTypeFilter",
        "dayCountSelector",
        "viewModeSelector",
        "prevButton",
        "nextButton",
        "subscribeButton"
      ],
      "viewModes": ["standard", "wide", "month"],
      "dayCountOptions": [7, 14],
      "eventTypeOptions": ["all", "superior-travel"]
    },
    "modes": {
      "month": {
        "weekdayHeader": {
          "columns": 7,
          "textAlign": "center",
          "fontSize": "{typography.sizes.xs}",
          "fontWeight": "{typography.weights.semibold}",
          "color": "{color.mutedForeground}",
          "paddingY": "0.5rem"
        },
        "grid": {
          "columns": 7,
          "gap": "0.25rem"
        },
        "dayCell": {
          "minHeight": "7rem",
          "radius": "{radius.lg}",
          "borderWidth": "1px",
          "padding": "0.25rem",
          "inMonth": {
            "background": "{color.surface}",
            "border": "{color.outline}"
          },
          "outOfMonth": {
            "background": "{color.surfaceLow}",
            "border": "{color.outline}"
          },
          "today": {
            "background": "{color.todayBg}",
            "border": "{color.todayBorder}",
            "dayNumberColor": "{color.primary}"
          }
        },
        "eventChip": {
          "display": "block full-width",
          "radius": "0.25rem",
          "padding": "0.125rem 0.25rem",
          "textAlign": "left",
          "background": "{color.surfaceHigh}",
          "hoverBackground": "{color.surfaceHigh}",
          "titleSize": "{typography.sizes.xs}",
          "titleWeight": "{typography.weights.medium}",
          "metaSize": "{typography.sizes.2xs}",
          "metaColor": "{color.mutedForeground}"
        }
      },
      "standard": {
        "layout": {
          "<sm": "1 column",
          ">=sm": "2 columns",
          "gap": "0.75rem"
        },
        "dayCard": {
          "radius": "{radius.xl}",
          "border": "1px solid {color.outline}",
          "background": "{color.surface}",
          "padding": "1rem",
          "titleSize": "{typography.sizes.sm}",
          "titleWeight": "{typography.weights.semibold}"
        },
        "eventRow": {
          "radius": "{radius.lg}",
          "border": "1px solid {color.outline}",
          "padding": "0.5rem 0.75rem",
          "hoverBackground": "{color.surfaceHigh}",
          "titleSize": "{typography.sizes.sm}",
          "titleWeight": "{typography.weights.medium}",
          "timeSize": "{typography.sizes.xs}",
          "metaSize": "{typography.sizes.xs}"
        }
      },
      "wide": {
        "scrollContainer": {
          "overflowX": "auto",
          "paddingBottom": "0.5rem"
        },
        "dayColumns": {
          "gridAuto": "repeat(dayCount, minmax(220px, 1fr))",
          "minTrackAreaWidth": "87.5rem",
          "gap": "1rem"
        },
        "dayColumnCard": {
          "minHeight": "36rem",
          "radius": "{radius.2xl}",
          "border": "1px solid {color.outline}",
          "background": "{color.surface}",
          "padding": "1rem",
          "shadow": "{shadow.base}"
        },
        "eventCard": {
          "radius": "{radius.xl}",
          "border": "1px solid {color.outline}",
          "background": "{color.surfaceLow}",
          "padding": "0.5rem 0.75rem",
          "hoverBackground": "{color.surfaceHigh}",
          "titleTruncate": true,
          "metaTruncate": true
        },
        "edgePaging": {
          "enabled": true,
          "edgeThresholdPx": 36,
          "cooldownMs": 160,
          "intentStaleMs": 1000,
          "triggerDeltaDay": 18,
          "triggerDeltaWeek": 96
        }
      },
      "specialFilteredList": {
        "item": {
          "width": "100%",
          "radius": "{radius.xl}",
          "border": "1px solid {color.outline}",
          "background": "{color.surface}",
          "padding": "0.75rem 1rem",
          "textAlign": "left",
          "hoverBackground": "{color.surfaceHigh}"
        }
      }
    },
    "conflictPanel": {
      "heading": {
        "size": "{typography.sizes.sm}",
        "weight": "{typography.weights.semibold}",
        "uppercase": true,
        "tracking": "{typography.tracking.wideUppercase}",
        "color": "{status.warning.text}"
      },
      "card": {
        "radius": "{radius.2xl}",
        "border": "1px solid {status.warning.border}",
        "background": "{status.warning.bg}",
        "padding": "1rem"
      },
      "resolveButton": {
        "radius": "{radius.lg}",
        "border": "1px solid {status.warning.border}",
        "background": "{color.surface}",
        "padding": "0.375rem 0.75rem",
        "size": "{typography.sizes.xs}",
        "weight": "{typography.weights.medium}"
      }
    },
    "floatingActionButton": {
      "position": {
        "mobile": "fixed bottom-6 right-6",
        "desktop": "fixed bottom-8 right-8"
      },
      "zIndex": 40,
      "shape": "circle",
      "padding": "1rem",
      "background": "{color.primary}",
      "iconColor": "{color.primaryInk}",
      "iconSize": "24px",
      "shadow": "{shadow.elevated}",
      "hover": {
        "shadowIntensity": "higher",
        "scale": "{motion.fabHoverScale}"
      },
      "action": "openCreateEventModal"
    }
  },
  "calendarModals": {
    "subscribe": {
      "panelSize": "2xl",
      "sections": [
        "Main community feed",
        "Feed profiles",
        "Presider-only subscriptions"
      ],
      "sectionCard": {
        "radius": "{radius.xl}",
        "border": "1px solid {color.outline}",
        "background": "{color.surfaceLow}",
        "padding": "0.75rem"
      },
      "copyFeedback": {
        "text": "Copied!",
        "size": "{typography.sizes.2xs}",
        "color": "{status.success.text}",
        "durationMs": 2000
      }
    },
    "createEvent": {
      "panelSize": "md",
      "fields": [
        "title",
        "date",
        "allDayToggle",
        "startTime/endTime (conditional)",
        "location",
        "description"
      ],
      "primaryAction": {
        "labelDefault": "Add event",
        "labelBusy": "Adding..."
      }
    },
    "editEvent": {
      "panelSize": "md",
      "supportsConditionalSections": [
        "dinnerTime",
        "readonlySyntheticNotice",
        "standardEventFields",
        "presider",
        "chapelAssignments"
      ],
      "actions": [
        "delete (admin/non-synthetic only)",
        "close",
        "save (if editable)"
      ],
      "saveBusyLabel": "Saving…"
    }
  },
  "interactionStates": {
    "active": {
      "segmentedControl": {
        "background": "{color.primary}",
        "text": "{color.primaryInk}"
      },
      "navItemMobile": {
        "text": "{color.primary}"
      },
      "navItemDesktop": {
        "background": "{color.primary}",
        "text": "{color.primaryInk}"
      }
    },
    "hover": {
      "genericControl": {
        "background": "{color.surfaceHigh}"
      },
      "cardLikeButton": {
        "background": "{color.surfaceHigh}"
      }
    },
    "disabled": {
      "opacity": 0.5,
      "cursor": "not-allowed"
    },
    "readonly": {
      "container": {
        "radius": "{radius.xl}",
        "border": "1px solid {color.outline}",
        "background": "{color.surfaceLow}",
        "padding": "0.75rem"
      },
      "helperTextSize": "{typography.sizes.xs}"
    }
  },
  "responsiveBehavior": {
    "<768": {
      "primaryCalendarDefaultView": "standard",
      "toolbarDayAndViewSelectors": "dropdowns",
      "sidebarNav": "hidden",
      "bottomNav": "visible",
      "formControlTextMinSizePx": 16
    },
    ">=768": {
      "primaryCalendarDefaultView": "month",
      "toolbarDayAndViewSelectors": "segmentedButtons",
      "sidebarNav": "visible",
      "bottomNav": "hidden"
    }
  },
  "nonVisualFunctionalContractsAffectingUI": {
    "calendar": {
      "dateNavigation": {
        "monthMode": "prev/next month",
        "rangeModes": "prev/next by selected dayCount"
      },
      "eventClick": "opens edit/details modal",
      "specialFilterMode": {
        "name": "superior-travel",
        "dateNavigationDisabled": true
      },
      "syntheticReadonlyEvents": {
        "editable": false,
        "showReadonlyNotice": true
      }
    },
    "copyButtons": {
      "clipboard": true,
      "inlineTemporaryFeedback": true
    }
  }
}